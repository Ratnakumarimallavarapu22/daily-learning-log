arr = list(map(int, input("Enter elements: ").split()))

frequency = {}

for num in arr:
    if num in frequency:
        frequency[num] += 1
    else:
        frequency[num] = 1

print("Element frequencies:")

for key, value in frequency.items():
    print(key, "->", value)

print("Repeated elements:")

for key, value in frequency.items():
    if value > 1:
        print(key, end=" ")
