nums = list(map(int, input("Enter numbers: ").split()))

numbers = set(nums)
longest = 0

for n in numbers:
    if n - 1 not in numbers:
        current = n
        length = 1

        while current + 1 in numbers:
            current += 1
            length += 1

        longest = max(longest, length)

print("Longest consecutive sequence length:", longest)
